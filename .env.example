# Django Environment Variables Template
# Copy this file to .env and fill in the values
# ============================================

# ==========================================
# SECURITY SETTINGS (PRODUCTION)
# ==========================================
# Set DEBUG=False untuk production
DEBUG=False

# Generate secret key yang kuat: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=yoursecretkeyhere

# Masukkan domain dan IP yang diizinkan
ALLOWED_HOSTS=webtest.smknj.sch.id,www.webtest.smknj.sch.id

# ==========================================
# DATABASE SETTINGS (MySQL)
# ==========================================
# Gunakan nama database lengkap dengan prefix cPanel username
DB_NAME=usernamecpanel_web_smknj_db
DB_USER=usernamecpanel_dbuser
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# ==========================================
# EMAIL SETTINGS (Optional)
# ==========================================
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# RECIPIENT_ADDRESS=smknurja.paiton@gmail.com

# ==========================================
# MEDIA & STATIC FILES
# ==========================================
# MEDIA_URL=https://webtest.smknj.sch.id/media/
# STATIC_URL=https://webtest.smknj.sch.id/static/
