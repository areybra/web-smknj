# ==========================================
# .gitignore untuk Django Project
# Project: web-smknj-2026
# ==========================================

# ==========================================
# ENVIRONMENT VARIABLES
# ==========================================
.env
.env.local
.env.*.local
.env.production

# ==========================================
# PYTHON
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# VIRTUAL ENVIRONMENT
# ==========================================
env/
venv/
ENV/
.venv/

# ==========================================
# DJANGO
# ==========================================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media
/staticfiles
/static_root

# ==========================================
# IDE
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ==========================================
# OS
# ==========================================
Thumbs.db
Desktop.ini

# ==========================================
# DATABASE BACKUPS
# ==========================================
*.sql
*.sqlite
*.db
*.dump

# ==========================================
# DEPLOYMENT (Keep these in repo)
# ==========================================
# passenger_wsgi.py  - KEEP (needed for cPanel)
# .htaccess          - KEEP (needed for Apache)
# requirements.txt   - KEEP (needed for pip install)

# ==========================================
# SENSITIVE FILES
# ==========================================
# Backup files with passwords
*password*.txt
*secret*.txt
*.key

# ==========================================
# UPLOADS (Optional - exclude user uploads)
# ==========================================
# media/uploads/
# media/news/
# media/staff/
# Note: Uncomment jika tidak ingin upload files ter-commit
